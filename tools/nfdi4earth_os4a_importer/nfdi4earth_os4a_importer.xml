<tool id="nfdi4earth_os4a" name="NFDI4Earth OneStop4All Importer" tool_type="data_source" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="20.09">
    <description>downloads content via NFDI4Earth's OneStop4All search user interface</description>
    <macros>
        <token name="@TOOL_VERSION@">1.2</token>
        <token name="@VERSION_SUFFIX@">1</token>
    </macros>
    <required_files>
        <include path="data_source.py"/>
    </required_files>
    <creator>
        <organization name="EOSC AquaINFRA" url="https://aquainfra.eu/"/>
    </creator>
    <command><![CDATA[
        python '$__tool_directory__/data_source.py' '$output' $__app__.config.output_size_limit
    ]]></command>
    <inputs action="https://onestop4all.nfdi4earth.de/search" check_values="false" method="get">
        <param name="GALAXY_URL" type="baseurl" value="/tool_runner" />
        <param name="tool_id" type="hidden" value="nfdi4earth_os4a" />
        <param name="sendToGalaxy" type="hidden" value="1" />
    </inputs>
    <request_param_translation>
        <request_param galaxy_name="title" remote_name="data_title" missing="unknown title" />
    </request_param_translation>
    <outputs>
        <data name="output" format="auto" label="${title}"/>
    </outputs>
    <options sanitize="False" refresh="True"/>
</tool>
