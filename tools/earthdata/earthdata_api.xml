<tool id="earthdata_api" name="earthdata API" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="25.1">
    <description>Fetching EarthData (NASA environment database)</description>
    
    <macros>
        <token name="@TOOL_VERSION@">0.1.0</token>
        <token name="@VERSION_SUFFIX@">0</token>
    </macros>

    <requirements>
        <requirement type="package" version="0.18.0">earthaccess</requirement>
        <credentials name="earthdata_cred" version="1.0" label="EarthData Access" description="Credentials for accessing EarthData Database">
            <variable name="username" inject_as_env="EARTHDATA_USERNAME" optional="false" 
                label="EarthData Username" description="Your Earthdata login pseudoname" />
            <secret name="secret_key" inject_as_env="EARTHDATA_PASSWORD" optional="false" 
                label="EarthData Secret Access Key" description="Your Earthdata login secret access key/ password" />
        </credentials>
    </requirements>
    <required_files>
        <include path="nasa_api.py" />
    </required_files>

    <command detect_errors="exit_code"><![CDATA[
    python '$__tool_directory__/nasa_api.py'
    --short_name '${short_name}'
    --lat_min  '${section_bounding_box.lat_min}'
    --lat_max  '${section_bounding_box.lat_max}'
    --lon_min  '${section_bounding_box.lon_min}'
    --lon_max  '${section_bounding_box.lon_max}'
    --start_date '${section_time_frame.start_date}'
    --end_date '${section_time_frame.end_date}'
    --exclude_dates '${section_time_frame.exclude_dates}'
    --exclude_ranges '${section_time_frame.exclude_ranges}'
    --out_file '${earthdata_output}'
    ]]></command>

    <inputs>
        <param name="short_name" type="text" label="Dataset short name" value="ATL06">
            <sanitizer invalid_char="">
                <valid initial="string.letters,string.digits">
                    <add value="_" />
                    <add value="-" />
                    <add value="." />
                </valid>
            </sanitizer>
            <validator type="regex">[0-9a-zA-Z_\-\. ]</validator>
        </param>
        
        <section name="section_bounding_box" title="Bounding Box" expanded="true">
            <param name="lat_min" type="float" label="Minimum latitude" value="-90"/>
            <param name="lat_max" type="float" label="Maximum latitude" value="90"/>
            <param name="lon_min" type="float" label="Minimum longitude" value="-180"/>
            <param name="lon_max" type="float" label="Maximum longitude" value="180"/>
        </section>

        <section name="section_time_frame" title="Time Frame (YYYY-MM/ YYYY-MM-DD)" expanded="true">
            <conditional name="time_input">
                <param name="temporal_resolution" type="select">
                    <option value="daily" selected="true">Daily</option>
                    <option value="monthly">Monthly</option>
                </param>
                
                <!-- DAILY -->
                <when value="daily">

                <param name="start_date" type="text" value="2018-10-14"
                    label="Start date (YYYY-MM-DD)">
                    <validator type="regex">^(19|20)\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$</validator>
                </param>

                <param name="end_date" type="text" value="2018-10-14"
                    label="End date (YYYY-MM-DD)">
                    <validator type="regex">^(19|20)\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$</validator>
                </param>

                <param name="exclude_dates" type="text" optional="true"
                    label="Exclude dates (comma-separated YYYY-MM-DD)">
                    <validator type="regex">^(\s*(19|20)\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])\s*)(,\s*\2-\3-\4\s*)*$</validator>
                </param>

                <param name="exclude_ranges" type="text" optional="true"
                    label="Exclude ranges (YYYY-MM-DD:YYYY-MM-DD)">
                    <validator type="regex">^(\s*(19|20)\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01]):(19|20)\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])\s*)(,\s*\2-\3-\4:\5-\6-\7\s*)*$</validator>
                </param>
                </when>


                <!-- MONTHLY -->
                <when value="monthly">

                    <param name="start_date" type="text" value="2018-10"
                        label="Start date (YYYY-MM)">
                        <validator type="regex">^(19|20)\d{2}-(0[1-9]|1[0-2])$</validator>
                    </param>

                    <param name="end_date" type="text" value="2018-10"
                        label="End date (YYYY-MM)">
                        <validator type="regex">^(19|20)\d{2}-(0[1-9]|1[0-2])$</validator>
                    </param>

                    <param name="exclude_dates" type="text" optional="true"
                        label="Exclude months (comma-separated YYYY-MM)">
                        <validator type="regex">^(\s*(19|20)\d{2}-(0[1-9]|1[0-2])\s*)(,\s*\2-\3\s*)*$</validator>
                    </param>

                    <param name="exclude_ranges" type="text" optional="true"
                        label="Exclude ranges (YYYY-MM:YYYY-MM)">
                        <validator type="regex">^(\s*(19|20)\d{2}-(0[1-9]|1[0-2]):(19|20)\d{2}-(0[1-9]|1[0-2])\s*)(,\s*\2-\3:\4-\5\s*)*$</validator>
                    </param>
                </when>
                <!-- SIMPLE XML -->
                <!-- <validator type="regex">
                ^\d{4}-(0[1-9]|1[0-2])(-[0-3]\d)?$
                </validator> -->
            </conditional>

        </section>
                
    </inputs>

    <outputs>
        <data format="txt" name="earthdata_output" label="NASA dataset"/>
    </outputs>
    
    <tests>
        <test>
            <param name="short_name" value="MODIS_AQUA_L3_SST_THERMAL_MONTHLY_9KM_DAYTIME_V2019.0"/>

            <section name="section_bounding_box">
                <param name="lat_min" value="-90"/>
                <param name="lat_max" value="90"/>
                <param name="lon_min" value="-180"/>
                <param name="lon_max" value="180"/>
            </section>

            <section name="section_time_frame">
                <conditional name="time_input">
                    <param name="start_date" value="2002-12-01"/>
                    <param name="end_date" value="2002-12-31"/>
                    <param name="exclude_dates" value=""/>
                    <param name="exclude_ranges" value=""/>
                </conditional>
            </section>

            <output name="earthdata_output" file="earthdata_output.txt"/>
        </test>
    </tests>

    <help><![CDATA[
    **What it does**

    This tool fetches NASA Earth science data from Earthdata using the `earthaccess` API.

    **Requirements**
    
    You must have an Earthdata account:
    https://urs.earthdata.nasa.gov/

    **Features**

    * Supports spatial bounding box filtering
    * Supports date ranges

    **Output**

    A text file listing downloaded files.
     

    ]]></help>
    <citations>
        <citation type="bibtex">
            @misc{Naming conventions - earthaccess,
                title = {earthaccess documentation},
                url = {https://earthaccess.readthedocs.io/en/latest/contributor/reference/naming-convention/},
                language={en} }
        </citation>
    </citations>
</tool>
